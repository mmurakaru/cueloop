{
  "name": "@cueloop/sync",
  "version": "0.1.0-alpha.115",
  "description": "General-purpose sync for terminals",
  "homepage": "https://github.com/mmurakaru/cueloop#readme",
  "bugs": {
    "url": "https://github.com/mmurakaru/cueloop/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmurakaru/cueloop.git",
    "directory": "packages/sync"
  },
  "bin": {
    "cueloop-sync": "./bin/cueloop-sync.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "migrations",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/sync-client.d.ts",
  "exports": {
    ".": "./dist/sync-client.js",
    "./schema": "./dist/sync-schema.js",
    "./storage": "./dist/sync-sqlite-storage.js",
    "./drafts": "./dist/sync-draft-store.js",
    "./queries": "./dist/sync-query.js",
    "./operations": "./dist/sync-operations.js",
    "./server": "./dist/sync-authority.js",
    "./serve": "./dist/sync-server.js",
    "./cli": "./dist/sync-cli.js",
    "./migrations/001-operation-receipt.sql": "./migrations/001-operation-receipt.sql",
    "./text": "./dist/sync-text.js",
    "./presence": "./dist/sync-presence-client.js",
    "./presence/server": "./dist/sync-presence-authority.js",
    "./execution": "./dist/sync-execution.js",
    "./execution/server": "./dist/sync-execution-authority.js",
    "./migrations/002-execution.sql": "./migrations/002-execution.sql",
    "./execution/schema": "./dist/sync-execution-schema.js",
    "./execution/http": "./dist/sync-execution-http.js",
    "./execution/worker": "./dist/sync-execution-worker.js",
    "./authority": "./dist/sync-authority-protocol.js",
    "./authority/server": "./dist/sync-authority-database.js",
    "./migrations/003-authority.sql": "./migrations/003-authority.sql",
    "./backup": "./dist/sync-backup.js",
    "./restore": "./dist/sync-restore.js",
    "./migrations": "./dist/sync-database-migration.js",
    "./authority/client": "./dist/sync-authority-client.js",
    "./database/status": "./dist/sync-database-status.js",
    "./database/initialize": "./dist/sync-database-initialize.js",
    "./migrations/004-restore-journal.sql": "./migrations/004-restore-journal.sql",
    "./transfer": "./dist/sync-transfer.js",
    "./migrations/005-workspace-transfer.sql": "./migrations/005-workspace-transfer.sql",
    "./rebind": "./dist/sync-workspace-rebind.js",
    "./telemetry": "./dist/sync-telemetry.js",
    "./telemetry/http": "./dist/sync-telemetry-http.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@rocicorp/zero": "1.11.4",
    "canonicalize": "5.1.0",
    "idb": "8.0.4",
    "postgres": "3.4.7",
    "uuid": "14.0.3",
    "valibot": "^1.5.0",
    "yjs": "13.6.33"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24"
  }
}
