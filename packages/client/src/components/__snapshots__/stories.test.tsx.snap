exports[`stories catalog PlanSheet/AnnotatedPlan renders, snapshots, and carries its colors: PlanSheet/AnnotatedPlan 1`] = `
"  submitted by agent/worker-3 · revision 1                                   Edit  Share  
                                                                                          
    Migration Plan                                                                        
                                                                                          
    Context                                                                               
                                                                                          
  ▎ The daemon persists sessions to disk atomically.                                      
                                                                                          
    Steps                                                                                 
                                                                                          
    - move the store                                                                      
    - add recovery                                                                        
                                                                                          
    ts                                                                                    
                                                                                          
      export function persist(session: Session): void {                                   
        // one JSON document per session                                                  
        writeAtomically(pathFor(session.id), serialize(session));                         
      }                                                                                   
                                                                                          
                                                                                          
                                                                                          
                                                                                          
                                                                                          
                                                                                          
                                                                                          
                                                                                          
                                                                                          
"
`;

