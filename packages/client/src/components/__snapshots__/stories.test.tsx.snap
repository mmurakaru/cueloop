exports[`stories catalog Surfaces/ThreadView/InlineThreads renders, snapshots, and carries its colors: Surfaces/ThreadView/InlineThreads 1`] = `
"                                                                                                    
  Migration Plan                                                                                    
                                                                                                    
  Context                                                                                           
                                                                                                    
  The daemon persists sessions to disk atomically.                                                  
                                                                                                    
  ╷─────────────────────────────────────────────────────────────────────────────────────────────┐   
  │ ● Which daemon owns this?                                                                   │   
  ╵─────────────────────────────────────────────────────────────────────────────────────────────┘   
                                                                                                    
  Steps                                                                                             
                                                                                                    
  · move the store                                                                                  
                                                                                                    
  ╷─────────────────────────────────────────────────────────────────────────────────────────────┐   
  │ ● move the store behind one interface                                                       │ ○ 
  ╵─────────────────────────────────────────────────────────────────────────────────────────────┘ ○ 
  · add recovery                                                                                    
                                                                                                    
  ts                                                                                                
  export function persist(session: Session): void {                                                 
    // one JSON document per session                                                                
    writeAtomically(pathFor(session.id), serialize(session));                                       
  }                                                                                                 
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
"
`;

