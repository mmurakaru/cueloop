{
  "name": "cueloop",
  "version": "0.1.0-alpha.84",
  "description": "Terminal review surface for coding agents: annotate plans and diffs, return a message, send structured feedback back",
  "homepage": "https://github.com/mmurakaru/cueloop#readme",
  "bugs": {
    "url": "https://github.com/mmurakaru/cueloop/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmurakaru/cueloop.git",
    "directory": "packages/cli"
  },
  "bin": {
    "cueloop": "./src/main.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/main.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:binary": "bun build --compile --minify --external cpu-features ./src/main.ts --outfile dist/cueloop"
  },
  "dependencies": {
    "@cueloop/adapters": "0.1.0-alpha.84",
    "@cueloop/client": "0.1.0-alpha.84",
    "@cueloop/daemon": "0.1.0-alpha.84",
    "@cueloop/schema": "0.1.0-alpha.84",
    "@modelcontextprotocol/server": "2.0.0",
    "@valibot/to-json-schema": "1.4.0",
    "valibot": "^1.4.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
