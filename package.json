{
  "name": "cueloop-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "packages/integrations/*"
  ],
  "scripts": {
    "prepare": "bun run --cwd packages/sync build",
    "dev": "bun run packages/cli/src/main.ts dev",
    "dev:watch": "CUELOOP_DEV_WATCH=1 bun --watch packages/cli/src/main.ts dev",
    "stories": "bun run packages/client/src/stories/stories-app.tsx",
    "stories:watch": "bun --watch packages/client/src/stories/stories-app.tsx",
    "test": "bun test --timeout 60000 ./packages ./test ./hooks",
    "test:pty": "CUELOOP_RUN_PTY=1 bun test --timeout 60000 ./test/pty",
    "test:sync": "CUELOOP_RUN_SYNC=1 bun test --timeout 120000 ./test/session/sync-*.test.ts",
    "test:install-vm": "bun run test/install/vm/runner.ts",
    "test:gateway-mirror": "bun run test/gateway/mirror/runner.ts",
    "bench": "bun run benchmarks/run.ts",
    "profile": "bun run benchmarks/profile.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint && bun run scripts/check-import-budgets.ts && bun run lint:boundaries",
    "deps:install": "bun install --cwd tools/dependency-cruiser --frozen-lockfile",
    "lint:boundaries": "node tools/dependency-cruiser/dependency-analysis.mjs check",
    "lint:site-boundaries": "node tools/dependency-cruiser/dependency-analysis.mjs check --site",
    "deps:report": "node tools/dependency-cruiser/dependency-analysis.mjs report",
    "test:boundaries": "bun test tools/dependency-cruiser/dependency-analysis.test.mjs",
    "format": "oxlint -A all -D statement-padding/blank-lines --fix && oxfmt packages test scripts site benchmarks hooks tools examples snapshots",
    "format:check": "oxlint -A all -D statement-padding/blank-lines && oxfmt --check packages test scripts site benchmarks hooks tools examples snapshots",
    "changeset": "changeset",
    "version": "changeset version && bun run scripts/rewrite-internal-deps.ts && bun run scripts/sync-plugin-version.ts && bun run scripts/sync-lockfile-versions.ts",
    "ci:publish": "bun run check:publish && changeset publish",
    "check:release": "bun run scripts/check-release-integrity.ts",
    "check:publish": "bun run scripts/check-publish-integrity.ts",
    "verify:published": "bun run scripts/verify-published.ts",
    "sync:dist-tags": "bun run scripts/sync-dist-tags.ts",
    "check:agent-laws": "bun run scripts/check-agent-laws.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@cueloop/client": "workspace:*",
    "@cueloop/daemon": "workspace:*",
    "@cueloop/schema": "workspace:*",
    "@cueloop/sync": "workspace:*",
    "@opentui/core": "^0.8.3",
    "@opentui/react": "^0.8.3",
    "@oxlint/plugins": "1.90.0",
    "@rocicorp/zero": "1.11.4",
    "@types/bun": "^1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "cueloop": "workspace:*",
    "effect": "^4.1.2",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "playwright": "1.65.0",
    "postgres": "3.4.7",
    "react": "^19.3.1",
    "ssh2": "^1.17.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0"
  },
  "dependencies": {},
  "overrides": {
    "tinypool": "2.2.0"
  }
}
