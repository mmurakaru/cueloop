{
  "name": "cueloop-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "packages/integrations/*"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/main.ts",
    "stories": "bun run packages/client/src/components/stories-app.tsx",
    "test": "bun test ./packages ./test",
    "test:pty": "CUELOOP_RUN_PTY=1 bun test ./test/pty",
    "typecheck": "bunx tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && bun run scripts/rewrite-internal-deps.ts && bun run scripts/sync-plugin-version.ts",
    "ci:publish": "bun run check:publish && changeset publish",
    "check:release": "bun run scripts/check-release-integrity.ts",
    "check:publish": "bun run scripts/check-publish-integrity.ts",
    "verify:published": "bun run scripts/verify-published.ts",
    "sync:dist-tags": "bun run scripts/sync-dist-tags.ts"
  },
  "devDependencies": {
    "@cueloop/client": "workspace:*",
    "@cueloop/daemon": "workspace:*",
    "@cueloop/schema": "workspace:*",
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "bun-pty": "^0.4.10",
    "cueloop": "workspace:*",
    "react": "^19.2.0",
    "typescript": "^5.9.3",
    "@changesets/cli": "^2.31.0",
    "@changesets/changelog-github": "^0.5.2"
  }
}