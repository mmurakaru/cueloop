{
  "name": "cueloop-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/main.ts",
    "test": "bun test ./packages",
    "test:pty": "CUELOOP_RUN_PTY=1 bun test ./test/pty",
    "typecheck": "bunx tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && bun run scripts/sync-plugin-version.ts",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@cueloop/client": "workspace:*",
    "@cueloop/daemon": "workspace:*",
    "@cueloop/schema": "workspace:*",
    "@opentui/core": "^0.4.3",
    "@opentui/react": "^0.4.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "cueloop": "workspace:*",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}