---
/*
 * cueloop mark: a clean outer circle with two morphed inner blobs offset
 * top-left, separated by real transparency (mask cut-outs) so the gaps match
 * whatever background is behind the mark. Pass a unique `uid` per instance on a
 * page so the mask ids do not collide.
 */
interface Props {
  size?: number;
  uid?: string;
  class?: string;
}
const { size = 20, uid = "cl", class: className } = Astro.props;

function blob(cx: number, cy: number, r: number, wobble: number, phase: number, n = 7) {
  const pts: [number, number][] = [];
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2 + phase * 0.4;
    const rad = r * (1 + wobble * Math.sin(i * 2.3 + phase));
    pts.push([cx + rad * Math.cos(a), cy + rad * Math.sin(a)]);
  }
  let d = `M ${pts[0][0].toFixed(2)} ${pts[0][1].toFixed(2)}`;
  for (let i = 0; i < n; i++) {
    const p0 = pts[(i - 1 + n) % n], p1 = pts[i], p2 = pts[(i + 1) % n], p3 = pts[(i + 2) % n];
    const c1x = p1[0] + (p2[0] - p0[0]) / 6, c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6, c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
  }
  return `${d} Z`;
}

const GAP = 1.4;
const midBlob = blob(13.6, 13.6, 9, 0.07, 0.6);
const midHole = blob(13.6, 13.6, 9 + GAP, 0.07, 0.6);
const innerBlob = blob(11, 11, 5.6, 0.09, 2.1);
const innerHole = blob(11, 11, 5.6 + GAP, 0.09, 2.1);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={className}
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <mask id={`clm-${uid}`}>
    <rect width="32" height="32" fill="#fff"></rect>
    <path d={midHole} fill="#000"></path>
  </mask>
  <mask id={`cli-${uid}`}>
    <rect width="32" height="32" fill="#fff"></rect>
    <path d={innerHole} fill="#000"></path>
  </mask>
  <circle cx="16" cy="16" r="12" fill="#9a9ca6" mask={`url(#clm-${uid})`}></circle>
  <path d={midBlob} fill="#6b6d76" mask={`url(#cli-${uid})`}></path>
  <path d={innerBlob} fill="#2f3037"></path>
</svg>
