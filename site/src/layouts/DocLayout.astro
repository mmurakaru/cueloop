---
import BaseLayout from "./BaseLayout.astro";
import { conceptPages } from "../concepts.ts";

interface Props {
  frontmatter: { title: string; description?: string; kicker?: string };
}

const { frontmatter } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<BaseLayout title={`${frontmatter.title} - cueloop`} description={frontmatter.description}>
  {frontmatter.kicker && <p class="kicker">{frontmatter.kicker}</p>}
  <h1>{frontmatter.title}</h1>
  <article>
    <slot />
  </article>

  <nav aria-label="Concepts">
    <h2>All concepts</h2>
    <ul class="card-grid">
      {
        conceptPages.map((page) => (
          <li class="card">
            <a href={page.href} aria-current={currentPath === page.href ? "page" : undefined}>
              {page.title}
            </a>
            <p>{page.summary}</p>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>
