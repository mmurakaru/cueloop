{
  "name": "cueloop-site",
  "version": "0.0.0",
  "private": true,
  "description": "Marketing and docs site for cueloop. Not part of the published cueloop npm package.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && bun run scripts/build-agent-markdown.ts",
    "preview": "astro preview",
    "check": "wrangler types --include-runtime=false --check && astro check",
    "test": "bun test ./src ./functions ./scripts",
    "verify:deployment": "bun run scripts/verify-deployment.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/react": "^5.0.7",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "astro": "^5.14.1",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "5.20260924.1",
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.0",
    "wrangler": "4.137.0"
  }
}
