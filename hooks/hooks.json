{
  "description": "cueloop Claude Mod lifecycle and Message delivery",
  "modules": ["./register.ts"],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run ${CLAUDE_PLUGIN_ROOT}/hooks/capability-guard.ts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
